<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Mini App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #f5f5f5;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .box {
      text-align: center;
      padding: 20px;
    }

    button {
      padding: 12px 18px;
      border: none;
      background: #0088cc;
      color: white;
      border-radius: 8px;
    }
  </style>
</head>

<body>

  <div class="box">
    <h1>🚀 Mini App Working</h1>
    <p id="user">Loading...</p>
    <button onclick="send()">Send Data</button>
  </div>

  <script>
    let tg = window.Telegram.WebApp;
    tg.expand();

    document.getElementById("user").innerText =
      "Hello " + (tg.initDataUnsafe.user?.first_name || "User");

    function send() {
      tg.sendData("Hello from mini app");
    }
  </script>

</body>
</html>
