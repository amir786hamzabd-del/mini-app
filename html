<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Mini App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      font-family: Arial;
      text-align: center;
      padding: 30px;
      background: #f2f2f2;
    }
    button {
      padding: 12px 20px;
      border: none;
      background: #0088cc;
      color: white;
      border-radius: 8px;
      font-size: 16px;
    }
  </style>
</head>
<body>

  <h1>🚀 My Telegram Mini App</h1>
  <p>Welcome to mini app</p>

  <button onclick="sendData()">Send Data</button>

  <script>
    let tg = window.Telegram.WebApp;
    tg.expand();

    function sendData() {
      tg.sendData("Hello from Mini App!");
    }
  </script>

</body>
</html>
